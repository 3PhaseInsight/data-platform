FROM apache/airflow:slim-2.11.0-python3.12

USER root

# Install system libraries
RUN apt-get update && apt-get install -y libgeos-dev libgomp1 libpq-dev libpq5 gcc

# Install any Python deps
COPY requirements.txt /requirements.txt

# Copy DAGs & source code
COPY dags/ /opt/airflow/dags/

USER airflow
ENV PATH="/home/airflow/.local/bin:${PATH}"

# Use BuildKit secret for pip.conf, mount it where 'airflow' can read it.
# NOTE the uid=50000 so the airflow user can read the secret.
RUN --mount=type=secret,id=pip_conf,target=/home/airflow/.pip/pip.conf,uid=50000,gid=0,mode=0400 \
    python -m pip install --user -U pip && \
    pip install --user --no-cache-dir -r /opt/airflow/requirements.txt
