# .env file to hold secrets for local dev
# Postgres DB connection
DB_TYPE=POSTGRES
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=3phi-db
DB_HOST=postgres
DB_PORT=5432

# Airflow secrets
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__API__SECRET_KEY=supersecretkey123
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME
AIRFLOW__CORE__FERNET_KEY=v0jI15uA7sIID7m2rDPTsfLI3LN2mMQz1Z_XWtYFNgE=
AIRFLOW_TMP_JWT_OVERRIDE=cR+iZrtNE7mPIgxSnVkUQw==

# Redis (Celery broker)
REDIS_PASSWORD=redispassword
AIRFLOW__CELERY__BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=3phi
MINIO_HOST=minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://${MINIO_HOST}

# REGISTRY
CI_REGISTRY_IMAGE=local
IMAGE_TAG=latest

# local dev volume mount
DAGS_DIR=./dags

# data-platform-api
API_KEYS=test-key
API_PORT=8000

