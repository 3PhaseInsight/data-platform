FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/api

COPY data-platform-api/ /opt/api/
RUN pip install --no-cache-dir /opt/api

EXPOSE 8000

CMD ["uvicorn", "data_platform_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
