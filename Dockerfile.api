FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/api

# Optional local framework wheel for dev (drop a wheel into tmp/ before build)
COPY ./tmp/ /opt/3phi-framework/
RUN if ls /opt/3phi-framework/*.whl >/dev/null 2>&1; then \
        pip install --no-cache-dir /opt/3phi-framework/3phi_framework-*.whl \
        && rm -rf /opt/3phi-framework ; \
    fi

COPY data-platform-api/ /opt/api/
RUN pip install --no-cache-dir /opt/api

EXPOSE 8000

CMD ["uvicorn", "data_platform_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
