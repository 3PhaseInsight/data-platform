FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/api

# Install runtime deps first for better layer caching: this layer only
# rebuilds when requirements-api.txt changes, not on every code edit.
COPY data-platform-api/requirements-api.txt /opt/api/requirements-api.txt
RUN pip install --no-cache-dir -r /opt/api/requirements-api.txt

COPY data-platform-api/ /opt/api/
RUN pip install --no-cache-dir --no-deps /opt/api

EXPOSE 8000

CMD ["uvicorn", "data_platform_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
